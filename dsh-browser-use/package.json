{
  "name": "dsh-browser-use",
  "version": "0.1.0",
  "description": "ZCode-style browser automation for dsh: host Playwright tools + persistent browser profile + drive/walkthrough skills.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./mcp": {
      "default": "./lib/mcp/server.js"
    },
    "./scripts/browser-client.mjs": "./scripts/browser-client.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/mcp/server.js",
    "lib/types/**/*.d.ts",
    "scripts/browser-client.mjs",
    "docs/**",
    "chrome-extension/**",
    "cordis.patch.yml",
    "skills/**",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Songmengdi/dp_harness_enhance.git",
    "directory": "dsh-browser-use"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "playwright-core": "^1.49.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.6",
    "@deepseek-ai/dsh-skill": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.host.json --noEmit",
    "build": "tsc -p tsconfig.host.json && tsdown",
    "prepare": "npm run build",
    "pack": "pnpm pack",
    "test": "node --test test/*.test.js",
    "verify": "npm run typecheck && npm run build && npm run test",
    "sync:profile": "cp lib/index.js lib/mcp/server.js \"$HOME/.dsh/profiles/web/node_modules/dsh-browser-use/lib/\" && mkdir -p \"$HOME/.dsh/profiles/web/node_modules/dsh-browser-use/scripts\" && cp scripts/browser-client.mjs \"$HOME/.dsh/profiles/web/node_modules/dsh-browser-use/scripts/\"",
    "dev": "npm run build && npm run sync:profile"
  }
}
