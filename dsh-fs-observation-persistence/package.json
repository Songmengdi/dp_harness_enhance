{
  "name": "dsh-fs-observation-persistence",
  "version": "0.2.1",
  "description": "Persistent observed-state overlay for the dsh fs policy layer: records each session's fs/observed versions to disk so a resumed session may write/edit without re-reading files that have not changed since it last observed them. Freshness stays enforced by the provider's version CAS — a changed file still forces a re-read.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/store.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Songmengdi/dp_harness_enhance.git",
    "directory": "dsh-fs-observation-persistence"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-fs": "^0.1.0-rc.6"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-fs": "0.1.0-rc.6",
    "@deepseek-ai/dsh-fs-local": "0.1.0-rc.6",
    "@deepseek-ai/dsh-fs-observation-policy": "0.1.0-rc.6",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.host.json --noEmit",
    "build": "tsc -p tsconfig.host.json",
    "prepare": "npm run build",
    "pack": "pnpm pack",
    "test": "node --test test/*.test.js",
    "verify": "npm run typecheck && npm run build && npm run test",
    "sync:profile": "cp lib/index.js lib/store.js \"$HOME/.dsh/profiles/web/node_modules/dsh-fs-observation-persistence/lib/\"",
    "dev": "npm run build && npm run sync:profile"
  }
}