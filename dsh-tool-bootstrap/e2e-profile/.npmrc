# Flat (npm-style) node_modules so EVERY bare specifier this profile resolves —
# direct deps and the transitive rows of the dsh-base bundle alike — comes from
# THIS profile's own copy. Without this, transitive names fall through Node's
# upward walk into the shared ~/.dsh/profiles/node_modules (harness-flavoured
# copies), mixing two dsh-scope module instances and breaking scope-key
# identity for preset mounts.
node-linker=hoisted
