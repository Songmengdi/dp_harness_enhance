{
  "name": "dsh-vision-bridge",
  "version": "0.1.0",
  "description": "视觉桥 Route C：给纯文本模型的 dsh Agent 装上完整视觉工程能力——managed Python runtime、按 Agent 渐进暴露的结构化视觉工具、seamless 粘贴/读图/截图桥。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "runtime/**",
    "skills/**",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Songmengdi/dp_harness_enhance.git",
    "directory": "vision-bridge"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.6",
    "@deepseek-ai/dsh-skill": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.host.json --noEmit",
    "build": "tsc -p tsconfig.host.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test test/*.test.js",
    "gate": "node scripts/test-gate.mjs",
    "verify": "node scripts/test-gate.mjs && npm run typecheck && npm run build && npm run test",
    "pack:dry": "npm pack --dry-run",
    "e2e": "node scripts/sync-e2e-profile.mjs && dsh --profile vision-bridge-e2e run-vision-bridge-e2e"
  }
}
